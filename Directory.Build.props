<Project>
  <PropertyGroup>
    <!--
      Single source of truth for the runtime version baked into produced executables / runtimeconfig.json.
      Previously duplicated across every csproj (~35 files) plus the scripts/updateFrameworkVersion.ps1 helper.
      Update this one line when bumping the patch version.
    -->
    <RuntimeFrameworkVersion>10.0.5</RuntimeFrameworkVersion>
  </PropertyGroup>
</Project>
